# authproxy remap: overlay prefix headers from a 2xx auth helper.
# Second rule is the internal auth sub-request (plugin skipped on internal txns).
map http://origin.lab/ http://origin:8080/ @plugin=authproxy.so @pparam=--auth-transform=redirect @pparam=--auth-host=auth @pparam=--auth-port=9000 @pparam=--forward-header-prefix=X-Auth-
map http://auth:9000/ http://auth:9000/
